generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String              @id @default(uuid())
  email                String              @unique
  passwordHash         String
  name                 String
  phone                String?
  avatar               String?
  status               String              @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  roleId               String?
  role                 Role?               @relation(fields: [roleId], references: [id], onDelete: SetNull)
  organizationId       String?
  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  refreshToken         String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  contacts             Contact[]           @relation("ContactOwner")
  leads                Lead[]              @relation("LeadOwner")
  deals                Deal[]              @relation("DealOwner")
  activitiesAssigned   Activity[]          @relation("AssignedActivities")
  activitiesCreated    Activity[]          @relation("CreatedActivities")
  tasksAssigned        Task[]              @relation("AssignedTasks")
  tasksCreated         Task[]              @relation("CreatedTasks")
  notes                Note[]
  notifications        Notification[]
  filesUploaded        FileRecord[]
  profileSettings      UserProfileSetting?
  activeWorkspaceId    String?
  activeWorkspace      Workspace?          @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  workspacesOwned      Workspace[]         @relation("WorkspaceOwner")
  workspaceMembers     WorkspaceMember[]
  teamsLed             Team[]              @relation("TeamOwner")
  teamMemberships      TeamMember[]
  sentEmails           EmailMessage[]      @relation("EmailSender")
  emailTemplates       EmailTemplate[]
  communicationComments CommunicationComment[]
  emailIntegrations    EmailIntegration[]
  searchHistory        SearchHistory[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  action      String           // CREATE, READ, UPDATE, DELETE, MANAGE
  resource    String           // USERS, CONTACTS, LEADS, DEALS, etc.
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  domain      String?
  industry    String?
  website     String?
  phone       String?
  address     String?
  city        String?
  country     String?
  status      String               @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  users       User[]
  contacts    Contact[]
  deals       Deal[]
  invites     OrganizationInvite[]
  teams       Team[]
  emails      EmailMessage[]
}

model OrganizationInvite {
  id             String       @id @default(uuid())
  email          String
  roleId         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token          String       @unique
  expiresAt      DateTime
  status         String       @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  createdAt      DateTime     @default(now())
}

model Pipeline {
  id          String          @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  stages      PipelineStage[]
  deals       Deal[]
}

model PipelineStage {
  id             String   @id @default(uuid())
  pipelineId     String
  pipeline       Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name           String
  order          Int
  winProbability Int      @default(10)
  color          String?  @default("#3b82f6")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deals          Deal[]
}

model Contact {
  id             String           @id @default(uuid())
  firstName      String
  lastName       String
  email          String           @unique
  phone          String?
  jobTitle       String?
  department     String?
  stage          String           @default("LEAD") // LEAD, OPPORTUNITY, CUSTOMER, CHURNED
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?            @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
  notes          Note[]
  attachments    FileAttachment[]
  emails         EmailMessage[]
  communicationComments CommunicationComment[]
}

model Lead {
  id                 String           @id @default(uuid())
  title              String
  firstName          String
  lastName           String
  email              String
  phone              String?
  companyName        String?
  status             String           @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED
  source             String           @default("WEBSITE") // WEBSITE, REFERRAL, COLD_OUTREACH, ADVERTISING, EVENT, OTHER
  leadScore          Int              @default(0)
  estimatedValue     Float?           @default(0.0)
  ownerId            String?
  owner              User?            @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teamId             String?
  team               Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  convertedContactId String?
  convertedDealId    String?
  workspaceId        String?
  leadSourceId       String?
  leadSource         LeadSource?      @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  webFormId          String?
  webForm            WebForm?         @relation(fields: [webFormId], references: [id], onDelete: SetNull)
  campaign           String?
  medium             String?
  channel            String?          // WEBSITE, LANDING_PAGE, SOCIAL_MEDIA, CAMPAIGN, EMAIL, REFERRAL, MANUAL
  attribution        Json?            @default("{}")
  qualificationNotes String?
  routedToId         String?
  scoringBreakdown   Json?            @default("[]")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  activities         Activity[]
  tasks              Task[]
  notes              Note[]
  attachments        FileAttachment[]
  formSubmissions    FormSubmission[]
  emails             EmailMessage[]
  communicationComments CommunicationComment[]
}

model Deal {
  id                String           @id @default(uuid())
  title             String
  value             Float            @default(0.0)
  currency          String           @default("USD")
  stageId           String?
  stage             PipelineStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)
  pipelineId        String?
  pipeline          Pipeline?        @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  status            String           @default("OPEN") // OPEN, WON, LOST
  probability       Int              @default(20)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  organizationId    String?
  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  contactId         String?
  contact           Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId           String?
  owner             User?            @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  teamId            String?
  team              Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  products          DealProduct[]
  activities        Activity[]
  tasks             Task[]
  notes             Note[]
  attachments       FileAttachment[]
  emails            EmailMessage[]
  communicationComments CommunicationComment[]
}

model Product {
  id            String        @id @default(uuid())
  name          String
  sku           String        @unique
  description   String?
  price         Float         @default(0.0)
  currency      String        @default("USD")
  isActive      Boolean       @default(true)
  stockQuantity Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  deals         DealProduct[]
}

model DealProduct {
  id        String   @id @default(uuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  unitPrice Float
  createdAt DateTime @default(now())

  @@unique([dealId, productId])
}

model Activity {
  id           String    @id @default(uuid())
  type         String    // CALL, EMAIL, MEETING, WHATSAPP, FOLLOW_UP
  subject      String
  description  String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  status       String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId       String?
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("AssignedActivities", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?     @relation("CreatedActivities", fields: [createdById], references: [id], onDelete: SetNull)
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Task {
  id           String    @id @default(uuid())
  title        String
  description  String?
  dueDate      DateTime?
  completedAt  DateTime?
  status       String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority     String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  contactId    String?
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId       String?
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Note {
  id        String   @id @default(uuid())
  title     String?
  content   String
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  isRead    Boolean   @default(false)
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model FileRecord {
  id           String           @id @default(uuid())
  originalName String
  fileName     String
  mimeType     String
  size         Int
  path         String
  uploadedById String?
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  attachments  FileAttachment[]
  createdAt    DateTime         @default(now())
}

model FileAttachment {
  id         String     @id @default(uuid())
  fileId     String
  file       FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  entityType String     // CONTACT, LEAD, DEAL, ORGANIZATION
  entityId   String
  contactId  String?
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL") // GENERAL, SECURITY, EMAIL, CRM
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model UserProfileSetting {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              String   @default("dark")
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  language           String   @default("en")
  timezone           String   @default("UTC")
  updatedAt          DateTime @updatedAt
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  avatar      String?
  website     String?
  timezone    String            @default("UTC")
  currency    String            @default("USD")
  status      String            @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  plan        String            @default("FREE")   // FREE, PRO, ENTERPRISE
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  roles       WorkspaceRole[]
  setting     WorkspaceSetting?
  activeUsers User[]            @relation("ActiveWorkspace")
  teams       Team[]
  emails      EmailMessage[]
  emailTemplates EmailTemplate[]
  emailIntegrations EmailIntegration[]
}

model WorkspaceRole {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isSystem    Boolean           @default(false)
  permissions Json              @default("[]")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     WorkspaceMember[]
  invites     WorkspaceInvite[]

  @@unique([workspaceId, name])
}

model WorkspaceSetting {
  id           String    @id @default(uuid())
  workspaceId  String    @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  general      Json      @default("{}")
  branding     Json      @default("{\"logoUrl\": null, \"faviconUrl\": null, \"primaryColor\": \"#3b82f6\", \"accentColor\": \"#10b981\"}")
  localization Json      @default("{\"timezone\": \"UTC\", \"currency\": \"USD\", \"language\": \"en\", \"dateFormat\": \"YYYY-MM-DD\", \"timeFormat\": \"24h\"}")
  preferences  Json      @default("{\"emailNotifications\": true, \"autoAssignLeads\": false, \"weeklyDigest\": true}")
  security     Json      @default("{\"enforceTwoFactor\": false, \"sessionTimeoutMinutes\": 1440, \"allowedEmailDomains\": [], \"ipAllowlist\": []}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model WorkspaceMember {
  id            String         @id @default(uuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId        String?
  workspaceRole WorkspaceRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  role          String         @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  status        String         @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  joinedAt      DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id            String         @id @default(uuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email         String
  roleId        String?
  workspaceRole WorkspaceRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)
  role          String         @default("MEMBER") // ADMIN, MEMBER, VIEWER
  token         String         @unique
  invitedById   String?
  expiresAt     DateTime
  status        String         @default("PENDING") // PENDING, ACCEPTED, CANCELLED, EXPIRED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Team {
  id             String        @id @default(uuid())
  name           String
  slug           String?
  description    String?
  avatar         String?
  color          String?       @default("#3b82f6")
  status         String        @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  targetRevenue  Float?        @default(0.0)
  ownerId        String
  owner          User          @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspaceId    String?
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members        TeamMember[]
  leads          Lead[]
  deals          Deal[]
  activities     Activity[]
  tasks          Task[]
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // LEADER, MEMBER
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
}

model LeadSource {
  id          String           @id @default(uuid())
  name        String
  code        String           @unique
  type        String           @default("WEBSITE") // WEBSITE, LANDING_PAGE, CAMPAIGN, SOCIAL_MEDIA, EMAIL, REFERRAL, MANUAL, PAID_SEARCH, EVENT, OTHER
  description String?
  status      String           @default("ACTIVE") // ACTIVE, INACTIVE
  cost        Float?           @default(0.0)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  isSystem    Boolean          @default(false)
  metadata    Json?            @default("{}")
  workspaceId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  leads       Lead[]
  submissions FormSubmission[]
  webForms    WebForm[]
}

model WebForm {
  id               String           @id @default(uuid())
  name             String
  slug             String           @unique
  title            String
  description      String?
  status           String           @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  formType         String           @default("WEB_FORM") // WEB_FORM, LANDING_PAGE, POPUP, EMBEDDED
  fields           Json             @default("[]")
  styling          Json             @default("{}")
  settings         Json             @default("{}")
  defaultSourceId  String?
  defaultSource    LeadSource?      @relation(fields: [defaultSourceId], references: [id], onDelete: SetNull)
  defaultOwnerId   String?
  campaignName     String?
  viewsCount       Int              @default(0)
  submissionsCount Int              @default(0)
  conversionRate   Float            @default(0.0)
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  workspaceId      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  leads            Lead[]
  submissions      FormSubmission[]
}

model FormSubmission {
  id           String      @id @default(uuid())
  formId       String
  form         WebForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  leadId       String?
  lead         Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadSourceId String?
  leadSource   LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  payload      Json        @default("{}")
  status       String      @default("PROCESSED") // PROCESSED, PENDING, SPAM, DUPLICATE, FAILED
  ipAddress    String?
  userAgent    String?
  referer      String?
  spamScore    Float       @default(0.0)
  isSpam       Boolean     @default(false)
  errorMessage String?
  submittedAt  DateTime    @default(now())
  workspaceId  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model LeadScoringRule {
  id             String   @id @default(uuid())
  name           String
  description    String?
  category       String   @default("DEMOGRAPHIC") // DEMOGRAPHIC, FIRMOGRAPHIC, BEHAVIORAL, SOURCE
  conditionField String
  operator       String   @default("EQUALS") // EQUALS, NOT_EQUALS, CONTAINS, NOT_CONTAINS, GREATER_THAN, LESS_THAN, IN, NOT_EMPTY, REGEX
  conditionValue String
  scoreChange    Int      @default(0)
  isActive       Boolean  @default(true)
  priority       Int      @default(0)
  workspaceId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model LeadQualificationRule {
  id           String   @id @default(uuid())
  name         String
  description  String?
  targetStatus String   @default("QUALIFIED") // QUALIFIED, UNQUALIFIED, CONTACTED, REVIEW_REQUIRED
  minScore     Int?
  conditions   Json     @default("[]")
  autoQualify  Boolean  @default(false)
  isActive     Boolean  @default(true)
  priority     Int      @default(0)
  workspaceId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LeadAssignmentRule {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  routingStrategy    String   @default("ROUND_ROBIN") // ROUND_ROBIN, SPECIFIC_USER, LOAD_BALANCED, SOURCE_BASED
  targetUserIds      Json     @default("[]")
  lastAssignedUserId String?
  conditions         Json     @default("[]")
  isActive           Boolean  @default(true)
  priority           Int      @default(0)
  workspaceId        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ==========================================
// Module 13: Communications & Email Models
// ==========================================

model EmailMessage {
  id                String                 @id @default(uuid())
  messageId         String?                @unique
  threadId          String?
  inReplyToId       String?
  folder            String                 @default("INBOX") // INBOX, SENT, DRAFTS, TRASH, ARCHIVE, SPAM
  direction         String                 @default("OUTBOUND") // INBOUND, OUTBOUND
  status            String                 @default("DRAFT") // DRAFT, QUEUED, SENT, DELIVERED, OPENED, CLICKED, BOUNCED, FAILED, RECEIVED
  sender            String
  senderName        String?
  senderUserId      String?
  senderUser        User?                  @relation("EmailSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  recipients        Json                   // Array of recipient strings or objects
  cc                Json                   @default("[]")
  bcc               Json                   @default("[]")
  replyTo           String?
  subject           String
  body              String
  bodyText          String?
  snippet           String?
  isRead            Boolean                @default(false)
  readAt            DateTime?
  isStarred         Boolean                @default(false)
  isArchived        Boolean                @default(false)
  isDraft           Boolean                @default(false)
  sentAt            DateTime?
  receivedAt        DateTime?
  scheduledAt       DateTime?
  provider          String?                @default("SYSTEM") // SMTP, SENDGRID, RESEND, GMAIL, OUTLOOK, SYSTEM
  providerMessageId String?
  providerMetadata  Json?                  @default("{}")
  errorMessage      String?
  openCount         Int                    @default(0)
  clickCount        Int                    @default(0)

  contactId         String?
  contact           Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId            String?
  deal              Deal?                  @relation(fields: [dealId], references: [id], onDelete: SetNull)
  organizationId    String?
  organization      Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspaceId       String?
  workspace         Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  attachments       EmailAttachment[]
  comments          CommunicationComment[]

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([threadId])
  @@index([folder])
  @@index([status])
  @@index([direction])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([senderUserId])
}

model EmailAttachment {
  id           String       @id @default(uuid())
  emailId      String
  email        EmailMessage @relation(fields: [emailId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String       @default("application/octet-stream")
  size         Int          @default(0)
  path         String?
  url          String?
  fileRecordId String?
  createdAt    DateTime     @default(now())

  @@index([emailId])
}

model EmailTemplate {
  id          String     @id @default(uuid())
  name        String
  description String?
  category    String     @default("GENERAL") // SALES, MARKETING, FOLLOW_UP, ONBOARDING, SUPPORT, GENERAL
  subject     String
  bodyHtml    String
  bodyText    String?
  variables   Json       @default("[]") // Array of variable tokens e.g. ["contact.firstName", "deal.title"]
  isShared    Boolean    @default(true)
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category])
  @@index([workspaceId])
  @@index([createdById])
}

model CommunicationComment {
  id             String        @id @default(uuid())
  emailId        String?
  email          EmailMessage? @relation(fields: [emailId], references: [id], onDelete: Cascade)
  threadId       String?
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId String?
  workspaceId    String?
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  content        String
  mentions       Json          @default("[]") // [{ "userId": "...", "name": "...", "email": "..." }]
  isInternal     Boolean       @default(true) // Always internal, never sent to external email recipients
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([emailId])
  @@index([threadId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([authorId])
  @@index([workspaceId])
}

model EmailIntegration {
  id                String     @id @default(uuid())
  provider          String     // SMTP, SENDGRID, RESEND, GMAIL, OUTLOOK, SYSTEM
  name              String     // e.g. "Primary SMTP", "SendGrid Outbound"
  fromEmail         String
  fromName          String?
  host              String?
  port              Int?
  secure            Boolean    @default(true)
  username          String?
  encryptedPassword String?    // Stored securely, NEVER exposed in responses/DTOs
  encryptedApiKey   String?    // Stored securely, NEVER exposed in responses/DTOs
  isDefault         Boolean    @default(false)
  isActive          Boolean    @default(true)
  workspaceId       String?
  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  settings          Json?      @default("{}")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([workspaceId])
  @@index([provider])
}

// ==========================================
// Module 16: Global Search History Model
// ==========================================

model SearchHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query        String
  entityType   String   @default("ALL") // ALL, LEADS, CONTACTS, COMPANIES, DEALS, ACTIVITIES, DOCUMENTS, NOTES, USERS
  resultsCount Int      @default(0)
  workspaceId  String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([workspaceId])
}


